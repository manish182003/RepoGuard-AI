# ==========================================
# RepoGuard AI Environment Configuration
# ==========================================

# Application Settings
APP_NAME=RepoGuard AI
APP_ENV=development

# Primary LLM Provider (Groq Cloud)
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# GitHub API & Automation Token
# Needs 'repo' scope for creating branches, commits, forks, and PRs
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_pat_here

# Resilient Fallback Tier 1 (Cloudflare Workers AI)
# Get your Cloudflare account ID and API token at: https://dash.cloudflare.com/
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_MODEL=@cf/qwen/qwen2.5-coder-32b-instruct

# Resilient Fallback Tier 2 (OpenRouter - Optional)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
